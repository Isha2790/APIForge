# Generate real values with:  bash scripts/gen-env.sh   (creates .env, never overwrites)
DATABASE_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
INTERNAL_SECRET=change-me-to-a-long-random-string
FAILURE_POLICY=fail-closed     # fail-closed | fail-open (what to do if Redis is unavailable)
GRAFANA_PASSWORD=change-me
# Email (password reset, invitations). Defaults send to the Mailpit container; set these for a real SMTP provider.
# PUBLIC_URL=https://app.example.com
# MAIL_FROM=APIForge <no-reply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
